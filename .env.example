# Ollama (used by ingestion pipeline)
OLLAMA_BASE_URL=http://localhost:11434

# LLM backend switcher: "vllm" or "ollama"
LLM_BACKEND=vllm

# vLLM (LLM inference when LLM_BACKEND=vllm)
VLLM_BASE_URL=http://localhost:8800
# LLM_MODEL=Qwen/Qwen3-30B-A3B            # vLLM default (MoE FP8: 30B params, 3B activos ~15GB VRAM)
# LLM_MODEL=qwen3:8b                    # Ollama default
LLM_MAX_TOKENS=2048                     # max output tokens
RAG_K=5                                 # number of RAG chunks retrieved per query
THINKING_BUDGET=512                     # Qwen3 thinking tokens (0=off, -1=unlimited)

# OpenAI (requerido para scoring RAGAS con Faithfulness + Context Precision)
OPENAI_API_KEY=sk-...