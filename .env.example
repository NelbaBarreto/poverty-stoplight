# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_rag
DB_USER=sgadmin
DB_PASSWORD=sg4dm1n!

# Ollama (used by ingestion pipeline)
OLLAMA_BASE_URL=http://localhost:11434

# LLM backend switcher: "vllm" or "ollama"
LLM_BACKEND=vllm

# vLLM — una instancia o varias en round-robin (comma-separated)
VLLM_BASE_URLS=http://localhost:8800
# max_tokens por instancia (mismo orden que VLLM_BASE_URLS); omitir = usa LLM_MAX_TOKENS
VLLM_MAX_TOKENS_LIST=2048
# LLM_MODEL=                            # vacío = auto-detectado desde /v1/models de cada instancia
# LLM_MODEL=Qwen/Qwen3.5-27B-GPTQ-Int4 # ejemplo con --tensor-parallel-size 2
# LLM_MODEL=qwen3:8b                    # Ollama default
LLM_MAX_TOKENS=2048                     # default para Ollama o instancia sin entry en la lista
RAG_K=5                                 # number of RAG chunks retrieved per query
THINKING_BUDGET=512                     # Qwen3 thinking tokens (0=off, -1=unlimited)
SYNC_PROMPT_FROM_DB=true                # true = sobreescribe prompt.txt desde DB al iniciar; false = usa prompt.txt local

# OpenAI (requerido para scoring RAGAS con Faithfulness + Context Precision)
OPENAI_API_KEY=sk-...