# Database Configuration
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Configuration (required for HuggingFace models)
# Get your token from: https://huggingface.co/settings/tokens
# You can use either HUGGINGFACE_API_TOKEN or HF_TOKEN
HUGGINGFACE_API_TOKEN=your_huggingface_token_here
# HF_TOKEN=your_huggingface_token_here

# Note: Embedding model endpoints are configured directly in src/embeddings_manager.py
# Edit the EMBEDDING_MODELS dictionary to add or modify endpoint URLs
